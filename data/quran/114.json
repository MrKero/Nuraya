[["قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","Kul eûzu bi rabbin nâs(nâsi)","Sag: Ich nehme Zuflucht beim Herrn der Menschen"],["مَلِكِ ٱلنَّاسِ","Melikin nâs(nâsi)","dem König der Menschen"],["إِلَٰهِ ٱلنَّاسِ","İlâhin nâs(nâsi)","dem Gott der Menschen"],["مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","Min şerril vesvâsil hannâs(hannâsi)","vor dem Übel des Einflüsterers, des Davonschleichers"],["ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","Ellezî yuvesvisu fî sudûrin nâs(nâsi)","der in die Brüste der Menschen einflüstert"],["مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","Minel cinneti ven nâs(nâsi)","von den Ginn und den Menschen"]]